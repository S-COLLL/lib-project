{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "outputDirectory": "frontend",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "maxDuration": 30, "includeFiles": "frontend/js/demo/{demo-data.js,package.json}" }
  },
  "redirects": [{ "source": "/demo", "destination": "/?demo=1", "permanent": false }],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
